  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2d5e33c67f312fe45b88b04a3aece7bb, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LanternKeeper.StoryNote
  noteId: Note2_SpiritBridge
  title: A page from Mabel's diary
  body: 'The creek bridge washed out years ago, but Grandpa crosses anyway. He says the boards never left, they only stopped showing off. Hold your light out and they come back, plain as moonlight.


    I tried it. He''s right. Then I swung the lantern up high to see better, the way you do for a scare, and the boards were gone again quick as a blink. Too much light is as bad as none.'
  readRange: 1.9
