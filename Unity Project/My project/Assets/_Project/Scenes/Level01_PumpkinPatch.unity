  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2d5e33c67f312fe45b88b04a3aece7bb, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LanternKeeper.StoryNote
  noteId: Note5_Home
  title: Pinned up in the farmyard
  body: 'If you are reading this, you crossed the patch, the graves and the corn with a candle still burning. Not many do.


    The farmhands were never cruel. They only wanted a light to walk home by, same as you.


    Come in. Set your lantern on the porch with the others. It will keep them calm until morning.


    - The Whitlows'
  readRange: 1.9
