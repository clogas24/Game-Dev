# Git ignore rules for Project 4 (Growth Spurt).
# The Unity project lives in GrowthSpurt/; design docs live in docs/.

# Unity generated folders (rebuilt automatically by Unity)
/GrowthSpurt/[Ll]ibrary/
/GrowthSpurt/[Tt]emp/
/GrowthSpurt/[Oo]bj/
/GrowthSpurt/[Bb]uild/
/GrowthSpurt/[Bb]uilds/
/GrowthSpurt/[Ll]ogs/
/GrowthSpurt/[Uu]ser[Ss]ettings/
/GrowthSpurt/[Mm]emoryCaptures/
/GrowthSpurt/[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/GrowthSpurt/[Aa]ssets/**/*.meta

# Autogenerated Jetbrains Rider plugin
/GrowthSpurt/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio / VS Code / Rider cache and project files (regenerated by Unity)
.vs/
.vscode/
.idea/
.gradle/
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics generated file
crashlytics-build.properties

# Packed Addressables
/GrowthSpurt/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*

# Temporary auto-generated Android Assets
/GrowthSpurt/[Aa]ssets/[Ss]treamingAssets/aa.meta
/GrowthSpurt/[Aa]ssets/[Ss]treamingAssets/aa/*

# OS junk
.DS_Store
Thumbs.db
